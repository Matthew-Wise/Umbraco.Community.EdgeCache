<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup Label="Umbraco — pinned to the 17.x line so install on 18.x is rejected">
    <PackageVersion Include="Umbraco.Cms" Version="[17.4.1,18.0.0)" />
    <PackageVersion Include="Umbraco.Cms.Api.Common" Version="[17.4.1,18.0.0)" />
    <PackageVersion Include="Umbraco.Cms.Api.Management" Version="[17.4.1,18.0.0)" />
    <PackageVersion Include="Umbraco.Cms.Web.Common" Version="[17.4.1,18.0.0)" />
    <PackageVersion Include="Umbraco.Cms.Web.Website" Version="[17.4.1,18.0.0)" />
  </ItemGroup>

  <ItemGroup Label="EdgeCache core — used by providers when packing for release (see provider csprojs)">
    <PackageVersion Include="Umbraco.Community.EdgeCache" Version="[17.0.0,18.0.0)" />
  </ItemGroup>

  <ItemGroup Label="Azure Front Door provider">
    <PackageVersion Include="Azure.ResourceManager.Cdn" Version="1.5.1" />
    <PackageVersion Include="Azure.Identity" Version="1.21.0" />
  </ItemGroup>

  <ItemGroup Label="Test site dependencies">
    <PackageVersion Include="Microsoft.ICU.ICU4C.Runtime" Version="72.1.0.3" />
    <PackageVersion Include="uSync" Version="17.3.2" />
  </ItemGroup>

</Project>
